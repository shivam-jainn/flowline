# --- Postgres (local dev) ---
POSTGRES_USER=flowline
POSTGRES_PASSWORD=flowline-dev
POSTGRES_DB=flowline
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

# Local Postgres URL (no DB needed by default — the app falls back to a
# JSON file when no URL is set; set this when running local Postgres):
# DATABASE_URL=postgresql://flowline:flowline-dev@127.0.0.1:5432/flowline?sslmode=disable

# --- Neon (prod) — uncomment to use ---
# Provider is inferred like shipyard-web: a neon.tech URL means Neon.
# DATABASE_URL=postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# (NEON_DATABASE_URL / LOCAL_DATABASE_URL also work as fallbacks.)

# --- Waitlist table ---
# Table name (letters, digits, underscore only; anything else falls back
# to "waitlist"). Change this if several apps share one database.
# WAITLIST_TABLE=waitlist_flowline

# --- Next.js flags ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WAITLIST_ENDPOINT=/api/waitlist
