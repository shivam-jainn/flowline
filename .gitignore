# ── Flowline monolith ignores ──────────────────────────────────────────
# Layout: platform/macos (SwiftPM) + core (Cargo) + shared (data) + tooling.
# Generated FFI/WASM outputs are rebuilt via `make ffi`
# (tooling/toolchain/build-rust-ffi.sh) and never committed.
# docs/ and shared/ are source — never ignore them.

# ── SwiftPM / Xcode (platform/macos) ─────────────────────────────────
platform/macos/.build/
.swiftpm/
*.xcodeproj/
*.xcworkspace/
DerivedData/
*.o
*.d

# ── macOS ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Rust (core) ────────────────────────────────────────────────────
core/target/
core/crates/flowline_ffi/pkg-web/
target/

# ── Generated UniFFI/XCFramework outputs (rebuilt by `make ffi`) ───
platform/macos/Generated/flowline_ffiFFI.xcframework/
platform/macos/Generated/FFIHeaders/
platform/macos/Generated/FlowlineFFI/flowline_ffi.swift
!platform/macos/Generated/FlowlineFFI/.gitkeep

# ── Release artifacts ──────────────────────────────────────────────
dist/

# ── Node / WASM ────────────────────────────────────────────────────
node_modules/
pkg/
*.wasm

# ── Secrets / local env ────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Local agent config (personal paths, never committed) ──────────
opencode.json

# ── Product docs (local only, never committed) ───────────────────────
docs/

# ── Waitlist webapp (local file backend, never commit signups) ─────────
webapp/data/
webapp/.next/
