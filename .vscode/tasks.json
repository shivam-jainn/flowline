{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flowline: Dev Loop (Build & Launch App)",
      "type": "shell",
      "command": "make dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$swiftc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Flowline: Build All",
      "type": "shell",
      "command": "make build",
      "group": "build",
      "problemMatcher": [
        "$swiftc"
      ]
    },
    {
      "label": "Flowline: Run Tests",
      "type": "shell",
      "command": "make test",
      "group": "test",
      "problemMatcher": [
        "$swiftc"
      ]
    },
    {
      "label": "Flowline: Bundle App",
      "type": "shell",
      "command": "make bundle",
      "group": "build",
      "problemMatcher": [
        "$swiftc"
      ]
    },
    {
      "label": "Flowline: Rebuild Rust FFI",
      "type": "shell",
      "command": "make ffi",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Flowline: Cargo Test Core",
      "type": "shell",
      "command": "cargo test --manifest-path core/Cargo.toml",
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}
